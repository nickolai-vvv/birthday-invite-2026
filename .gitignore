# Dependencies and package-manager caches
/node_modules/
/.pnp/
.pnp.*
/.npm/
/.pnpm-store/
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Next.js generated files and build output
/.next/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# Local environment and secrets
.env*
!.env.example
!.env.sample
*.pem
*.key

# Test reports and tooling caches
/coverage/
/playwright-report/
/test-results/
/blob-report/
/.cache/
/.turbo/
.eslintcache

# Hosting metadata
/.vercel/
/.netlify/

# Logs and scratch files
*.log
/work/
*.tmp
*.bak
*.swp
*.swo
*~

# Operating systems and editors
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
